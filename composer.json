{
    "name": "php-collective/laravel-djot",
    "description": "Laravel integration for php-collective/djot — Blade directives, services, validation, and caching",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "package",
        "djot",
        "markup",
        "blade",
        "parser"
    ],
    "authors": [
        {
            "name": "PHP Collective",
            "homepage": "https://github.com/php-collective"
        }
    ],
    "homepage": "https://github.com/php-collective/laravel-djot",
    "require": {
        "php": "^8.2",
        "php-collective/djot": "^0.1.24",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "php-collective/code-sniffer": "dev-master",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "PhpCollective\\LaravelDjot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpCollective\\LaravelDjot\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "PhpCollective\\LaravelDjot\\LaravelDjotServiceProvider"
            ],
            "aliases": {
                "Djot": "PhpCollective\\LaravelDjot\\Facades\\Djot"
            }
        }
    },
    "scripts": {
        "cs-check": "phpcs -p",
        "cs-fix": "phpcbf -p",
        "stan": "phpstan analyse",
        "stan-setup": "composer require --dev phpstan/phpstan",
        "test": "phpunit"
    }
}
